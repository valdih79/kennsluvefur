---
import Header from "../components/Header.astro";
import "../styles/global.css";
import "../styles/header.css";
import "../styles/course.css";

interface Props {
    title?: string;
}

const { title = "Kennsluvefur" } = Astro.props;
---

<!doctype html>
<html lang="is">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width"
        />
        <meta
            name="description"
            content="Kennsluefni, sýnidæmi og æfingar."
        />

        <title>{title}</title>
    </head>

		<body>
				<Header />

				<main class="page-container">
						<slot />
				</main>
		</body>
</html>