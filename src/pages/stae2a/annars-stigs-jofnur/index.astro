---
import Layout from "../../../layouts/Layout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title="Annars stigs jöfnur | STÆ2A">
    <section class="course-header">
        <p class="course-code">STÆ2A</p>

        <h1>Annars stigs jöfnur</h1>

        <p>
            Kennsluefni, sýnidæmi og æfingar um annars stigs jöfnur.
        </p>
    </section>

    <section>
        <h2>Efni</h2>

        <div class="chapter-list">
            <a
                class="chapter-card"
                href={`${base}/stae2a/annars-stigs-jofnur/inngangur`}
            >
                <span class="chapter-number">01</span>

                <div>
                    <h3>Inngangur</h3>
                    <p>
                        Hvað eru annars stigs jöfnur?
                    </p>
                </div>

                <span class="chapter-arrow">→</span>
            </a>
        </div>
    </section>
</Layout>