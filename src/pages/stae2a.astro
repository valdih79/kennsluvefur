---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
---

<Layout title="STÆ2A | Kennsluvefur">
    <section class="course-header">
        <p class="course-code">STÆ2A</p>
        <h1>STÆ2A</h1>
        <p>Veldu kafla til að skoða kennsluefni, sýnidæmi og æfingar.</p>
    </section>

    <section>
        <h2>Kaflar</h2>

        <div class="chapter-list">
            <a
                class="chapter-card"
                href={`${base}/stae2a/annars-stigs-jofnur`}
            >
                <span class="chapter-number">01</span>

                <div>
                    <h3>Annars stigs jöfnur</h3>
                    <p>
                        Kennsluefni og æfingar um annars stigs jöfnur.
                    </p>
                </div>

                <span class="chapter-arrow">→</span>
            </a>
            <a
                class="chapter-card"
                href={`${base}/stae2a/fleygbogar`}
            >
                <span class="chapter-number">02</span>
                <div>
                    <h3>Fleygbogar</h3>
                    <p>Kennsluefni og æfingar um fleygboga.</p>
                </div>
                <span class="chapter-arrow">→</span>
            </a>
        </div>
    </section>
</Layout>